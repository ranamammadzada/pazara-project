# PazaRa Backend Environment Variables
# Bu dosyayı kendi ayarlarınıza göre düzenleyin

# ─── Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pazara_db

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=pazara_super_secret_jwt_key_2026_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Frontend URL (CORS) ────────────────────────────────
FRONTEND_URL=http://localhost:5173
